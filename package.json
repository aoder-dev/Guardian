{
  "name": "security-verification-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord member verification bot with automatic unverified/member role management",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "test": "node --test",
    "check": "node --check src/index.js && node --check scripts/deploy-commands.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
