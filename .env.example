# Copy this file to .env and fill in your own values.
# Never commit .env or share its contents.

DISCORD_TOKEN=PUT_YOUR_NEW_BOT_TOKEN_HERE
CLIENT_ID=PUT_YOUR_APPLICATION_ID_HERE
GUILD_ID=PUT_YOUR_SERVER_ID_HERE

# Optional: a local HTTP health-check port for hosting platforms.
# Leave unset to disable the health server.
# PORT=3000

# Optional: where persistent configuration is stored.
# Defaults to data/config.json.
# DATA_FILE=/app/data/config.json

# Optional: debug, info, warn, or error. Defaults to info.
# LOG_LEVEL=info
